<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Clubhouse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg container" aria-label="Main navigation">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">c.</span>clubhouse<span class="brand-dot">/</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-controls="navigation" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navigation">
                <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="nav-link" asp-controller="TrainingSessions" asp-action="Schedule">Schedule</a>
                    <a class="nav-link" asp-controller="Trainers" asp-action="Index">Trainers</a>
                    <a class="nav-link" asp-controller="Members" asp-action="Index">Members</a>
                    <a class="nav-link" asp-controller="TrainingSessions" asp-action="Index">Sessions</a>
                    <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                </div>
            </div>
        </nav>
    </header>
    <main id="main" class="container main-content">
        <partial name="_Notifications" />
        @RenderBody()
    </main>
    <footer class="container site-footer"><span><strong>clubhouse/</strong> &nbsp; A place to move. A community to grow.</span><span>Sports club management · Sofia time</span></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
