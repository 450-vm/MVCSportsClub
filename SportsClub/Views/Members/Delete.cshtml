@model Member
@{ ViewData["Title"] = "Delete member"; }
<div class="page-heading"><div><p class="eyebrow">CONFIRM DELETION</p><h1>Delete @Model.FullName?</h1></div></div>
<div class="surface form-panel"><div asp-validation-summary="All" class="text-danger" role="alert"></div><p>This permanently removes the member and their @Model.Enrollments.Count enrollment(s). Their places in training sessions will become available.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><div class="form-actions"><button class="btn btn-danger" type="submit">Delete member</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark">Cancel</a></div></form></div>
