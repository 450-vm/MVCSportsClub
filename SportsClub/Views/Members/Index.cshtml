@model List<Member>
@{ ViewData["Title"] = "Members"; }
<div class="page-heading"><div><p class="eyebrow">STRONGER TOGETHER</p><h1>Your club community.</h1><p class="page-intro">Every member is part of the story.</p></div><a asp-action="Create" class="btn btn-primary">+ Add member</a></div>
@if (Model.Count == 0)
{ <div class="empty-state"><h2>Make room for your first member</h2><p>Add a member, then enroll them in a training session.</p></div> }
else
{
    <div class="table-responsive surface"><table class="table align-middle mb-0"><thead><tr><th scope="col">Member</th><th scope="col">Email</th><th scope="col">Phone</th><th scope="col">Joined</th><th scope="col">Actions</th></tr></thead><tbody>
    @foreach (var member in Model)
    { <tr><td><a class="entity-link" asp-action="Details" asp-route-id="@member.Id">@member.FullName</a></td><td>@member.Email</td><td>@member.PhoneNumber</td><td class="text-nowrap">@member.JoinDate.ToString("dd MMM yyyy")</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@member.Id" aria-label="Edit @member.FullName">Edit</a><span class="action-divider">/</span><a asp-action="Delete" asp-route-id="@member.Id" aria-label="Delete @member.FullName">Delete</a></td></tr> }
    </tbody></table></div>
}
