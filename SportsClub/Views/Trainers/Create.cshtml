@model TrainerInput
@{ ViewData["Title"] = "Add trainer"; }
<div class="page-heading"><div><p class="eyebrow">GROW THE TEAM</p><h1>Add a trainer.</h1></div></div>
<form asp-action="Create" method="post" class="surface form-panel"><partial name="_Fields" model="Model" /><div class="form-actions"><button class="btn btn-primary" type="submit">Create trainer</button><a asp-action="Index" class="btn btn-outline-dark">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
