@model Trainer
@{ ViewData["Title"] = Model.FullName; }
<div class="page-heading"><div><p class="eyebrow">TRAINER PROFILE</p><h1>@Model.FullName</h1><p class="page-intro">@Model.Specialization</p></div><div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit trainer</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a></div></div>
<div class="surface p-4 mb-4"><dl class="detail-list mb-0"><dt>Email</dt><dd>@Model.Email</dd><dt>Phone</dt><dd>@Model.PhoneNumber</dd></dl></div>
<h2 class="mb-3">Training sessions</h2>
@if (!Model.TrainingSessions.Any())
{ <p>No sessions assigned yet.</p> }
else
{ <div class="surface p-4"><ul class="session-list">@foreach (var session in Model.TrainingSessions.OrderBy(x => x.StartDateTime)) { <li><a asp-controller="TrainingSessions" asp-action="Details" asp-route-id="@session.Id">@session.Title</a><span>@ClubTime.Display(session.StartDateTime)</span></li> }</ul></div> }
<a class="back-link" asp-action="Index">← All trainers</a>
