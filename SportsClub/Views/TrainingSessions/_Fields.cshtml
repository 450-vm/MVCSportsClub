@model SessionInput
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="TrainerId" class="form-label"></label><select asp-for="TrainerId" asp-items="Model.Trainers" class="form-select"><option value="">Choose a trainer</option></select><span asp-validation-for="TrainerId" class="text-danger"></span>@if (Model.Trainers.Count == 0) { <p class="form-text">You’ll need to <a asp-controller="Trainers" asp-action="Create">add a trainer</a> before creating a session.</p> }</div>
<div class="mb-3"><label asp-for="StartLocal" class="form-label"></label><input asp-for="StartLocal" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><span asp-validation-for="StartLocal" class="text-danger"></span></div>
<div class="row g-3"><div class="col-sm-6"><label asp-for="DurationMinutes" class="form-label"></label><input asp-for="DurationMinutes" class="form-control" min="1" max="480" /><span asp-validation-for="DurationMinutes" class="text-danger"></span></div><div class="col-sm-6"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" class="form-control" min="1" max="1000" /><span asp-validation-for="Capacity" class="text-danger"></span></div></div>
